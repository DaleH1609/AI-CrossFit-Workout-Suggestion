# .env.example — copy to .env.local and fill in real values.
# All variables marked [required] must be set; the app will not start correctly
# without them. Variables marked [optional] have safe defaults or degrade gracefully.

# ─── Supabase ─────────────────────────────────────────────────────────────────

# Your Supabase project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key (Settings → API → Project API keys → anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key — full RLS bypass. KEEP SECRET. Never commit.
# (Settings → API → Project API keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Authentication ────────────────────────────────────────────────────────────

# Comma-separated list of email addresses allowed to access /admin.
# Fail-closed: leave empty and the admin UI is inaccessible to everyone.
ADMIN_EMAILS=you@example.com

# ─── Booking confirmation tokens ───────────────────────────────────────────────

# HMAC secret used to sign and verify booking confirmation tokens sent by email.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be consistent across all instances (Vercel deployments share it via env var).
BOOKING_TOKEN_SECRET=change-me-generate-a-32-byte-hex-secret

# ─── Cron jobs ─────────────────────────────────────────────────────────────────

# Secret used to authenticate Vercel cron requests to /api/cron/* routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in vercel.json cron headers and here.
CRON_SECRET=change-me-generate-a-32-byte-hex-secret

# ─── Email (Resend) ────────────────────────────────────────────────────────────

# Resend API key (resend.com → API Keys)
RESEND_API_KEY=re_your_resend_api_key

# The "From" address for transactional emails. Must be a verified domain in Resend.
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Fallback support address shown to members in error emails.
SUPPORT_EMAIL=support@yourdomain.com

# ─── AI (Anthropic) ────────────────────────────────────────────────────────────

# Anthropic API key for workout generation (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=sk-ant-your-key

# Maximum number of AI calls allowed per gym per calendar month.
# Defaults to 50 if not set. Must be a positive integer.
AI_MONTHLY_LIMIT=50

# ─── Rate limiting (Upstash Redis) ────────────────────────────────────────────

# Upstash Redis REST URL and token (console.upstash.com → your database → REST API)
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Web Push (VAPID) ──────────────────────────────────────────────────────────

# VAPID key pair for browser push notifications. Generate once with:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
# Copy vapidPublicKey → VAPID_PUBLIC_KEY + NEXT_PUBLIC_VAPID_PUBLIC_KEY
# Copy vapidPrivateKey → VAPID_PRIVATE_KEY (keep secret, never expose)
VAPID_PUBLIC_KEY=your-vapid-public-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_MAILTO=mailto:admin@yourdomain.com

# ─── Error monitoring (Sentry) ─────────────────────────────────────────────────

# Sentry DSN — obtain from sentry.io → your project → Settings → Client Keys.
# Server-side error capture (route handlers, server actions).
# Leave unset to disable Sentry (app functions normally without it).
SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/YYYYYYY

# Same DSN exposed to the browser for client-side error capture.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXX.ingest.sentry.io/YYYYYYY

# Required only for source-map uploads at build time (CI only).
# SENTRY_AUTH_TOKEN=sntrys_your_auth_token
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# ─── Cron healthchecks ─────────────────────────────────────────────────────────

# Ping URLs for monitoring cron liveness (Healthchecks.io, Better Stack, etc.).
# Each cron route POSTs to its URL on success. Leave unset to disable heartbeats.
# Alert if no ping in 25+ hours to catch missed runs before they affect members.
# CRON_HEARTBEAT_GENERATE_INSTANCES=https://hc-ping.com/your-uuid
# CRON_HEARTBEAT_WAITLIST_EXPIRE=https://hc-ping.com/your-uuid

# ─── App ───────────────────────────────────────────────────────────────────────

# Public-facing app URL — used to build confirm/cancel links in emails.
# No trailing slash. In production this is your Vercel deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
